{
  "name": "ping-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "generate-seed": "tsx scripts/generate-config-seed.ts",
    "seed": "npm run generate-seed && wrangler kv key put --binding=CONFIG_KV config --path=./scripts/config-seed.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
