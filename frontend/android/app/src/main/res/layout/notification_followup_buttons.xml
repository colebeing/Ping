<?xml version="1.0" encoding="utf-8"?>
<!-- Same reasoning as notification_yesno_buttons.xml: plain clickable TextViews instead of
     Buttons so the whole thing fits within Android's ~64dp collapsed-view height ceiling without
     clipping, for both the collapsed and expanded slot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <TextView
        android:id="@+id/followup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/followup_btn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="1dp"
            android:paddingEnd="1dp" />

        <TextView
            android:id="@+id/followup_btn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="1dp"
            android:paddingEnd="1dp" />

        <TextView
            android:id="@+id/followup_btn3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="1dp"
            android:paddingEnd="1dp" />

        <TextView
            android:id="@+id/followup_btn4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="1dp"
            android:paddingEnd="1dp" />

    </LinearLayout>

</LinearLayout>
