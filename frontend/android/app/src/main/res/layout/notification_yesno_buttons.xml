<?xml version="1.0" encoding="utf-8"?>
<!-- The question text lives here, not in setContentTitle() — DecoratedCustomViewStyle's own
     title/text chrome wasn't reliably rendering above the custom view on device, so this view is
     self-contained. Tap targets are plain clickable TextViews, not Buttons — a Button's own
     enforced minimum touch-target height pushed this past Android's ~64dp collapsed-view ceiling
     and got clipped; this stays compact enough to fit both collapsed and expanded without clipping,
     so both buttons are visible and tappable immediately with no expand tap needed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <TextView
        android:id="@+id/yesno_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/yesno_btn_yes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="Yes"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/yesno_btn_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="No"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

</LinearLayout>
